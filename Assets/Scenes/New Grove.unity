    - target: {fileID: 3803047099492716171, guid: b5a65936c7fe74e3ca085c517af15846,
        type: 3}
      propertyPath: m_Name
      value: Fungal Tree
      objectReference: {fileID: 0}
    - target: {fileID: 5782225187683042707, guid: b5a65936c7fe74e3ca085c517af15846,
        type: 3}
      propertyPath: m_LocalPosition.y
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 8487882406260847969, guid: b5a65936c7fe74e3ca085c517af15846,
        type: 3}
      propertyPath: initailDialogue.Array.size
      value: 7
      objectReference: {fileID: 0}
    - target: {fileID: 8487882406260847969, guid: b5a65936c7fe74e3ca085c517af15846,
        type: 3}
      propertyPath: initailDialogue.Array.data[0]
      value: 'Hey buddy, look at you!

        Out here looking for the party huh?'
      objectReference: {fileID: 0}
    - target: {fileID: 8487882406260847969, guid: b5a65936c7fe74e3ca085c517af15846,
        type: 3}
      propertyPath: initailDialogue.Array.data[1]
      value: 'Well guess what...

        You ARE the party.'
      objectReference: {fileID: 0}
    - target: {fileID: 8487882406260847969, guid: b5a65936c7fe74e3ca085c517af15846,
        type: 3}
      propertyPath: initailDialogue.Array.data[2]
      value: 'So let''s get

        this party started.'
      objectReference: {fileID: 0}
    - target: {fileID: 8487882406260847969, guid: b5a65936c7fe74e3ca085c517af15846,
        type: 3}
      propertyPath: initailDialogue.Array.data[3]
      value: 'First job... SPORES.

        You''re gonna need

        at least
        10 of them.'
      objectReference: {fileID: 0}
    - target: {fileID: 8487882406260847969, guid: b5a65936c7fe74e3ca085c517af15846,
        type: 3}
      propertyPath: initailDialogue.Array.data[4]
      value: 'Oh wait...

        you already have some?'
      objectReference: {fileID: 0}
    - target: {fileID: 8487882406260847969, guid: b5a65936c7fe74e3ca085c517af15846,
        type: 3}
      propertyPath: initailDialogue.Array.data[5]
      value: 'Alright then,

        forget what I said.

        New plan.'
      objectReference: {fileID: 0}
    - target: {fileID: 8487882406260847969, guid: b5a65936c7fe74e3ca085c517af15846,
        type: 3}
      propertyPath: initailDialogue.Array.data[6]
      value: 'Hmmm...

        what else do we need?'
      objectReference: {fileID: 0}
    - target: {fileID: 8878330857342311414, guid: b5a65936c7fe74e3ca085c517af15846,
        type: 3}
      propertyPath: m_Priority
      value: 9
      objectReference: {fileID: 0}
